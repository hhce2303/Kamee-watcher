{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Watcher",
  "version": "0.1.0",
  "identifier": "com.sig.thewatcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The Watcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "mini",
        "url": "index.html?window=mini",
        "title": "The Watcher · Mini",
        "width": 320,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://watcher.localhost data:; media-src 'self' http://watcher.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": []
  }
}
