{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Watcher",
  "version": "0.1.0",
  "identifier": "com.sig.thewatcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "The Watcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": false,
      "sidecar": true,
      "scope": [
        {
          "name": "python-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": []
  }
}
